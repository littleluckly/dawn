{{ 'product-card.css' | asset_url | stylesheet_tag }}
<p>section.id: {{ section.id }}</p>
<p>product.handle: {{ product.handle }}</p>
<p>product.url: {{ product.url }}</p>
<p>request.origin: {{ request.origin }}</p>
<div class="product-card">
  <div class="product-card--left">
    <div class="product-card--feature-media">
      {{
        product.selected_or_first_available_variant.featured_image
        | product_img_url: '480x480'
        | img_tag: product.title
      }}
      {% assign variant_images = product.media | where: 'media_type', 'image' | map: 'src' %}
      <script>
        console.log('variant_images', {{ variant_images | json }});
        console.log('options_with_values', {{ product.options_with_values | json }});
      </script>
    </div>
    <div class="product-card--medias">
      {% for media in variant_images %}
        <div class="product-card--media">
          {{ media | image_url: '100x100' | img_tag: product.title }}
        </div>
      {% endfor %}
    </div>
  </div>
  <div class="product-card--right">
    <fieldset class="product-card--variant-options">
      {% for option in product.options_with_values %}
        <legend>{{ option.name }}</legend>
        {% for value in option.values %}
          <input
            type="radio"
            id="option-{{ option.position }}-{{ value }}"
            name="option-{{ option.position }}"
            value="{{ value.selected }}"
            data-option-id="{{ value.id }}"
          >
          <label for="option-{{ option.position }}-{{ value.name }}">
            {{- value -}}
            {{- value.id -}}
          </label>
        {% endfor %}
      {% endfor %}
    </fieldset>
  </div>
  <script>
    document.querySelectorAll('.product-card--variant-options input[type="radio"]').forEach(function (input) {
      input.addEventListener('change', function () {
        const selectedOptions = Array.from(
          document.querySelectorAll('.product-card--variant-options input[type="radio"]:checked')
        ).map(function (checkedInput) {
          return checkedInput.dataset.optionId;
        });
        console.log('Selected options:', selectedOptions);
        fetch(
          `{{ request.origin }}{{ product.url }}?section_id={{ section.id }}&option_values=${selectedOptions.join(',')}`
        )
          .then((response) => response.json())
          .then((data) => {
            console.log('Variant data:', data);
            // Update the product card with the new variant data
          });
      });
    });
  </script>
