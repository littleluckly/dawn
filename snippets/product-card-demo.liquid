{{ 'product-card.css' | asset_url | stylesheet_tag }}
<div class="product-card">
  <div class="product-card--left">
    <div class="product-card--feature-media">
      {{
        product.selected_or_first_available_variant.featured_image
        | product_img_url: '480x480'
        | img_tag: product.title
      }}
    </div>
    <div class="product-card--medias">
      {% for media in product.media %}
        <div class="product-card--media">
          {{ media | media_img_tag: '100x100' }}
        </div>
      {% endfor %}
    </div>
  </div>
  <div class="product-card--right"></div>
</div>
